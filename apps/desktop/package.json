{
  "name": "@art-text/desktop",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "node -e \"require('fs').rmSync('../../release',{recursive:true,force:true})\" && vite build && electron-builder"
  },
  "build": {
    "appId": "com.arttext.generator",
    "productName": "矢量艺术字生成器",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      { "from": "../../services/txt2img-api/dist/txt2img-backend.exe", "to": "backend/txt2img-backend.exe" },
      { "from": "../../scripts/download-comfyui-engine.ps1", "to": "backend/download-comfyui-engine.ps1" },
      { "from": "../../scripts/download-models.ps1", "to": "backend/download-models.ps1" },
      { "from": "../../scripts/configure-comfyui.ps1", "to": "backend/configure-comfyui.ps1" },
      { "from": "../../services/txt2img-api/custom_nodes", "to": "backend/custom-node-patches" },
      { "from": "../../services/vectorizer-api/dist/vectorizer-backend.exe", "to": "backend/vectorizer-backend.exe" },
      { "from": "../../services/vectorizer-api/dist/models", "to": "backend/models" },
      { "from": "../../apps/cli/dist/gen2vec_cli.exe", "to": "../gen2vec_cli.exe" },
      { "from": "../../tests/run-acceptance.ps1", "to": "../tests/run-acceptance.ps1" },
      { "from": "../../tests/run-acceptance.bat", "to": "../tests/run-acceptance.bat" },
      { "from": "../../tests/fixtures/acceptance.txt", "to": "../tests/acceptance.txt" },
      { "from": "../../tests/run-scenarios.py", "to": "../tests/run-scenarios.py" },
      { "from": "../../tests/acceptance_common.py", "to": "../tests/acceptance_common.py" },
      { "from": "../../tests/run-scenarios.bat", "to": "../tests/run-scenarios.bat" },
      { "from": "../../tests/fixtures/routes.txt", "to": "../tests/routes.txt" }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "electron/installer.nsh"
    }
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.2.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.12",
    "wait-on": "^9.0.6"
  }
}
